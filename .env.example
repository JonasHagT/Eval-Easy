# Copy this file to .env.local (npm run setup does that) and fill in real values.
# .env.local is gitignored — never commit keys.

ANTHROPIC_API_KEY=sk-ant-...

# Claude Console managed-agent deployment. When set, chat uses that agent.
ANTHROPIC_DEPLOYMENT_ID=depl_...

# Optional fallbacks if the deployment cannot be fetched:
# ANTHROPIC_AGENT_ID=agent_...
# ANTHROPIC_ENVIRONMENT_ID=env_...
# ANTHROPIC_VAULT_IDS=vlt_...
